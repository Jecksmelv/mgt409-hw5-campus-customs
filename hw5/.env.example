# Copy this file to .env (in this hw5/ folder) and fill in your own values.
# Never commit .env. It is listed in .gitignore.

# Portkey API key. Every AI call goes through the Portkey gateway (https://api.portkey.ai/v1).
PORTKEY_API_KEY=your-portkey-api-key-here

# Model configuration: the only model this project uses is gpt-6-luna, routed by Portkey to the
# "openai" provider. Both values are set in backend/llm.py (MODEL_NAME, PORTKEY_PROVIDER) and are
# deliberately not overridable, so no other model can be used by accident. Listed here for reference:
# MODEL_NAME=gpt-6-luna
# PORTKEY_PROVIDER=openai

# Optional, for the React dashboard only (put it in frontend/.env if the API is not on localhost:8000):
# VITE_API_BASE=http://localhost:8000
